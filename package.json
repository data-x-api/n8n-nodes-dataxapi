{
	"name": "n8n-nodes-dataxapi",
	"version": "0.2.0",
	"description": "n8n node for DataXAPI: public data from Douyin, Xiaohongshu (RedNote), WeChat Official Accounts and Channels, Weibo, Bilibili, Zhihu, Kuaishou, TikTok, YouTube, X and Reddit. No platform login; paid per call, errors are not charged.",
	"license": "MIT",
	"homepage": "https://github.com/data-x-api/n8n-nodes-dataxapi#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"dataxapi",
		"douyin",
		"xiaohongshu",
		"rednote",
		"wechat",
		"tiktok",
		"social media",
		"market data"
	],
	"author": {
		"name": "DataXAPI",
		"email": "support@dataxapi.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/data-x-api/n8n-nodes-dataxapi.git"
	},
	"bugs": {
		"url": "https://github.com/data-x-api/n8n-nodes-dataxapi/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test \"test/*.test.js\"",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/DataXApiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/DataXApi/DataXApi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
