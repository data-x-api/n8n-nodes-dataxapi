{
  "name": "DataXAPI: daily WeChat Official Account articles to Google Sheets",
  "nodes": [
    {
      "parameters": {
        "content": "## New Official Account articles into a sheet\nOnce a day, reads the latest page of one WeChat Official Account (gh_ original ID) and appends articles not seen before to Google Sheets.\n\n**Cost:** 1 DataXAPI call a run (one page, about 10 articles). Price: see https://dataxapi.com/apis/wechat_mp/accounts/articles/list/\n\nSet the account ID, connect Google Sheets, pick your spreadsheet, then activate.",
        "height": 300,
        "width": 420
      },
      "id": "2ff18d7c-92ed-56a5-a8fb-f7f8578e3e9d",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -260
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "ee65be7c-936f-5ef1-b05a-a468dd54fe18",
      "name": "Every day at 9:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "resource": "wechat_mp",
        "operation": "wechat_mp.accounts.articles.list",
        "id": "gh_13c97ab93ce8",
        "maxPages": 1,
        "output": "items",
        "options": {}
      },
      "id": "e8a1f296-1973-585f-8080-e94908e22f5c",
      "name": "Get Official Account articles",
      "type": "n8n-nodes-dataxapi.dataXApi",
      "typeVersion": 1,
      "position": [
        220,
        100
      ],
      "credentials": {
        "dataXApiApi": {
          "id": "",
          "name": "DataXAPI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Keep only items not seen in earlier runs. Static data persists only when the\n// workflow is active (production runs), not in manual test runs.\nconst seen = $getWorkflowStaticData('global');\nseen.ids = seen.ids || [];\nconst known = new Set(seen.ids);\nconst fresh = $input.all().filter((item) => item.json.id && !known.has(item.json.id));\nseen.ids = [...seen.ids, ...fresh.map((item) => item.json.id)].slice(-2000);\nreturn fresh.map((item) => ({\n  json: {\n    id: item.json.id,\n    title: item.json.title,\n    url: item.json.url,\n    published_at: item.json.published_at,\n    digest: item.json.text,\n  },\n}));"
      },
      "id": "056fd5d5-959c-596b-a04c-b21c240f7a44",
      "name": "Keep new articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        100
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "930e3915-1a4e-54a1-bf33-f8262fbc96c7",
      "name": "Append to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        100
      ]
    }
  ],
